# ---- Emberfall Kingdom server config ----
# Copy to .env and fill in. Never commit .env.

# Public domain pointing at the box (DNS A record). Caddy gets TLS automatically.
DOMAIN=api.emberfall.game

# Postgres password (used by both postgres and emberfalld via docker-compose).
POSTGRES_PASSWORD=change-me-to-something-long-and-random

# HS256 secret for game session JWTs. Generate: openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48

# Apple Sign in: your Services ID (the `aud` we check identity tokens against).
APPLE_SERVICES_ID=com.example.emberfall.signin

# Dev/TestFlight auth (POST /v1/auth/dev). MUST be 0 in production.
ALLOW_DEV_AUTH=0

# Admin API bearer token (spawn worlds, grant items, ban). Generate like JWT_SECRET.
ADMIN_TOKEN=change-me-admin-token
